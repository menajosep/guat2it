{
  "name": "guat2it",
  "private": true,
  "version": "0.1.0",
  "description": "Personal meal planner, starting with a shopping list.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "spec:validate": "openspec validate --all --strict --no-interactive",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run spec:validate"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.5.3",
    "@ionic/react": "^9.0.7",
    "@ionic/react-router": "^9.0.7",
    "dexie": "^4.4.6",
    "ionicons": "^8.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^6.30.6",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3",
    "@eslint/js": "^10.0.1",
    "@fission-ai/openspec": "~1.3.1",
    "@playwright/test": "^1.64.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
